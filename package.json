{
  "name": "willow-discord-bridge",
  "version": "0.3.1",
  "description": "Tiny Windows tray app that mutes Discord while Willow Voice is dictating",
  "author": "Willow Discord Bridge contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-frontend.mjs",
    "dev": "npm run build && tauri dev",
    "tauri": "tauri",
    "dist": "tauri build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "version": "node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "typescript": "^7.0.2"
  }
}
